{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "path": "users/{userId}",
      "description": "Property Agent profile, credentials, and subscription state",
      "fields": {
        "id": { "type": "string", "description": "Agent User ID matching Auth UID" },
        "name": { "type": "string", "description": "Agent full name" },
        "agencyName": { "type": "string", "description": "Real estate agency name" },
        "phone": { "type": "string", "description": "Agent phone number" },
        "email": { "type": "string", "description": "Agent email address" },
        "city": { "type": "string", "description": "Primary operating city" },
        "reraNumber": { "type": "string", "description": "Agent RERA license registration", "optional": true },
        "subscriptionStatus": { "type": "string", "description": "Google Play subscription status" },
        "isTrialActive": { "type": "boolean", "description": "Whether 30-day free trial is active" },
        "trialStartDate": { "type": "string", "description": "ISO timestamp of trial start" },
        "trialEndDate": { "type": "string", "description": "ISO timestamp of trial end", "optional": true },
        "trialDaysRemaining": { "type": "number", "description": "Calculated days remaining in trial" },
        "isSubscribed": { "type": "boolean", "description": "Whether active pro subscriber" },
        "subscriptionPlan": { "type": "string", "description": "Plan ID", "optional": true },
        "subscriptionExpiryDate": { "type": "string", "description": "ISO timestamp of next renewal or expiry", "optional": true },
        "subscriptionProductId": { "type": "string", "description": "Product ID (property_agent_pro)", "optional": true },
        "subscriptionBasePlan": { "type": "string", "description": "Base plan ID (monthly)", "optional": true },
        "autoRenewing": { "type": "boolean", "description": "Whether auto-renew is active", "optional": true },
        "purchaseToken": { "type": "string", "description": "Google Play purchase token", "optional": true },
        "paymentIssueMessage": { "type": "string", "description": "Payment grace notification", "optional": true },
        "isFeatureLocked": { "type": "boolean", "description": "Whether actions are locked", "optional": true },
        "darkMode": { "type": "boolean", "description": "Theme preference", "optional": true },
        "notificationsEnabled": { "type": "boolean", "description": "Notification settings", "optional": true },
        "isOnboarded": { "type": "boolean", "description": "Onboarding completion flag" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp", "optional": true },
        "updatedAt": { "type": "string", "description": "ISO update timestamp", "optional": true }
      }
    },
    "Lead": {
      "collection": "leads",
      "path": "users/{userId}/leads/{leadId}",
      "description": "Customer lead record with property preferences, follow-ups and activity timeline",
      "fields": {
        "id": { "type": "string", "description": "Unique Lead ID" },
        "name": { "type": "string", "description": "Customer name" },
        "phone": { "type": "string", "description": "Customer phone number" },
        "email": { "type": "string", "description": "Customer email", "optional": true },
        "requirement": { "type": "string", "description": "buy | rent | invest" },
        "propertyType": { "type": "string", "description": "apartment | villa | plot | commercial" },
        "budgetMin": { "type": "number", "description": "Minimum budget in INR", "optional": true },
        "budgetMax": { "type": "number", "description": "Maximum budget in INR" },
        "preferredLocations": { "type": "array", "description": "Array of preferred localities" },
        "preferredCity": { "type": "string", "description": "Target city" },
        "currentCity": { "type": "string", "description": "Customer current city", "optional": true },
        "currentLocality": { "type": "string", "description": "Customer current locality", "optional": true },
        "bhk": { "type": "string", "description": "BHK configuration preference" },
        "priority": { "type": "string", "description": "hot | warm | cold" },
        "stage": { "type": "string", "description": "new | contacted | requirement_collected | site_visit_scheduled | negotiation | closed_won | closed_lost" },
        "status": { "type": "string", "description": "Status code" },
        "source": { "type": "string", "description": "Lead source channel" },
        "possession": { "type": "string", "description": "Possession timeline preference", "optional": true },
        "investmentType": { "type": "string", "description": "Investment purpose", "optional": true },
        "notes": { "type": "string", "description": "Agent notes", "optional": true },
        "tags": { "type": "array", "description": "Lead tags", "optional": true },
        "nextFollowUpDate": { "type": "string", "description": "Scheduled follow-up date YYYY-MM-DD", "optional": true },
        "nextFollowUpTime": { "type": "string", "description": "Scheduled follow-up time HH:MM", "optional": true },
        "nextFollowUpNote": { "type": "string", "description": "Scheduled follow-up agenda", "optional": true },
        "followUpCount": { "type": "number", "description": "Total follow-ups executed", "optional": true },
        "activities": { "type": "array", "description": "Full activity timeline of calls, site visits, messages" },
        "createdAt": { "type": "string", "description": "Creation ISO date" },
        "updatedAt": { "type": "string", "description": "Last updated ISO date" }
      }
    },
    "Property": {
      "collection": "properties",
      "path": "users/{userId}/properties/{propertyId}",
      "description": "Agent inventory property listings for customer matching and sharing",
      "fields": {
        "id": { "type": "string", "description": "Unique Property ID" },
        "title": { "type": "string", "description": "Listing title" },
        "propertyType": { "type": "string", "description": "apartment | villa | plot | commercial" },
        "listingType": { "type": "string", "description": "sell | rent" },
        "price": { "type": "number", "description": "Price in INR" },
        "pricePerSqFt": { "type": "number", "description": "Rate per sq ft", "optional": true },
        "bhk": { "type": "string", "description": "1 BHK | 2 BHK | 3 BHK | 4+ BHK" },
        "bathrooms": { "type": "number", "description": "Bathroom count", "optional": true },
        "superBuiltUpAreaSqFt": { "type": "number", "description": "Super built-up area" },
        "carpetAreaSqFt": { "type": "number", "description": "Carpet area", "optional": true },
        "locality": { "type": "string", "description": "Locality / Sector / Area name" },
        "city": { "type": "string", "description": "City" },
        "furnishing": { "type": "string", "description": "unfurnished | semi_furnished | fully_furnished" },
        "floor": { "type": "string", "description": "Floor details", "optional": true },
        "facing": { "type": "string", "description": "East | North | North-East etc.", "optional": true },
        "parking": { "type": "string", "description": "Parking configuration", "optional": true },
        "ownershipType": { "type": "string", "description": "freehold | leasehold", "optional": true },
        "ageOfPropertyYears": { "type": "number", "description": "Property age", "optional": true },
        "reraApproved": { "type": "boolean", "description": "Whether RERA approved", "optional": true },
        "reraRegistrationNumber": { "type": "string", "description": "RERA ID", "optional": true },
        "ownerName": { "type": "string", "description": "Owner / Builder name" },
        "ownerPhone": { "type": "string", "description": "Owner contact phone" },
        "ownerWhatsApp": { "type": "string", "description": "Owner WhatsApp number", "optional": true },
        "notes": { "type": "string", "description": "Internal agent notes", "optional": true },
        "amenities": { "type": "array", "description": "List of amenities" },
        "photos": { "type": "array", "description": "Property photo URLs" },
        "documents": { "type": "array", "description": "Property document references", "optional": true },
        "status": { "type": "string", "description": "available | under_offer | sold | rented" },
        "viewsCount": { "type": "number", "description": "View analytics", "optional": true },
        "inquiriesCount": { "type": "number", "description": "Inquiry count", "optional": true },
        "createdAt": { "type": "string", "description": "Creation ISO date" },
        "updatedAt": { "type": "string", "description": "Update ISO date" }
      }
    },
    "WhatsAppTemplate": {
      "collection": "templates",
      "path": "users/{userId}/templates/{templateId}",
      "description": "Customizable WhatsApp quick communication templates",
      "fields": {
        "id": { "type": "string", "description": "Template ID" },
        "title": { "type": "string", "description": "Template label" },
        "category": { "type": "string", "description": "Category" },
        "description": { "type": "string", "description": "Template purpose" },
        "content": { "type": "string", "description": "Message body with placeholders" },
        "variables": { "type": "array", "description": "Interpolation variable tags" },
        "isDefault": { "type": "boolean", "description": "System default template" }
      }
    },
    "SubscriptionRecord": {
      "collection": "subscriptions",
      "path": "subscriptions/{userId}",
      "description": "Durable verified Google Play subscription and trial status per user",
      "fields": {
        "userId": { "type": "string", "description": "Agent User ID" },
        "subscriptionStatus": { "type": "string", "description": "TRIAL | ACTIVE | CANCELED_BUT_ACTIVE | PAYMENT_ISSUE | EXPIRED" },
        "trialStartDate": { "type": "string", "description": "ISO timestamp of trial commencement" },
        "trialEndDate": { "type": "string", "description": "ISO timestamp of trial completion" },
        "subscriptionExpiryDate": { "type": "string", "description": "ISO timestamp of Play Store expiration", "optional": true },
        "subscriptionProductId": { "type": "string", "description": "Product ID (property_agent_pro)" },
        "subscriptionBasePlan": { "type": "string", "description": "Base Plan ID (monthly)" },
        "purchaseToken": { "type": "string", "description": "Google Play purchase token", "optional": true },
        "orderId": { "type": "string", "description": "Google Play Order ID", "optional": true },
        "autoRenewing": { "type": "boolean", "description": "Auto renew state" },
        "acknowledged": { "type": "boolean", "description": "Play Store acknowledgment state" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    }
  }
}
