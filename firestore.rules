rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the caller owns the user resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Root user document
    match /users/{userId} {
      // Agents can read their own profile. Subscription entitlement fields are
      // authoritative backend data and cannot be created or changed by clients.
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'isSubscribed',
          'subscriptionStatus',
          'subscriptionExpiryDate',
          'subscriptionExpiryTime',
          'expiryDate',
          'subscriptionProductId',
          'subscriptionBasePlan',
          'subscriptionBasePlanId',
          'planId',
          'autoRenewing',
          'purchaseToken',
          'orderId',
          'acknowledged',
          'lastVerifiedAt',
          'purchaseDate'
        ])
        && (!('trialEverStarted' in request.resource.data) || request.resource.data.trialEverStarted == false)
        && (!('trialStatus' in request.resource.data) || request.resource.data.trialStatus == 'not_started');
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isSubscribed',
          'subscriptionStatus',
          'subscriptionExpiryDate',
          'subscriptionExpiryTime',
          'expiryDate',
          'subscriptionProductId',
          'subscriptionBasePlan',
          'subscriptionBasePlanId',
          'planId',
          'autoRenewing',
          'purchaseToken',
          'orderId',
          'acknowledged',
          'lastVerifiedAt',
          'purchaseDate',
          'trialStartDate',
          'trialEndDate',
          'trialEverStarted',
          'trialStatus'
        ]);
      allow delete: if isOwner(userId);

      // Leads subcollection - strictly isolated to the authenticated agent
      // Contains customer details, BHK, requirements, budget, follow-ups, and activity history
      match /leads/{leadId} {
        allow read, write: if isOwner(userId);
      }

      // Properties subcollection - strictly isolated to the authenticated agent
      // Contains inventory, owner contact, photos, and matching attributes
      match /properties/{propertyId} {
        allow read, write: if isOwner(userId);
      }

      // WhatsApp templates subcollection - strictly isolated to the authenticated agent
      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Subscriptions collection: durable Google Play verification and entitlement data
    match /subscriptions/{userId} {
      allow read, write: if true;
    }

    // Fallback: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
