rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the caller owns the user resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user account is active (not marked deleted)
    function isAccountActive(userId) {
      return isOwner(userId)
        && (!exists(/databases/$(database)/documents/users/$(userId))
            || !('isDeleted' in get(/databases/$(database)/documents/users/$(userId)).data)
            || get(/databases/$(database)/documents/users/$(userId)).data.isDeleted == false);
    }

    // Root user document
    match /users/{userId} {
      // Agents can read their own profile if not marked deleted. Subscription entitlement
      // fields are authoritative backend data and cannot be created or changed by clients.
      allow read: if isOwner(userId)
        && (!('isDeleted' in resource.data) || resource.data.isDeleted == false);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'isSubscribed',
          'subscriptionStatus',
          'subscriptionExpiryDate',
          'subscriptionExpiryTime',
          'expiryDate',
          'subscriptionProductId',
          'subscriptionBasePlan',
          'subscriptionBasePlanId',
          'planId',
          'autoRenewing',
          'purchaseToken',
          'orderId',
          'acknowledged',
          'lastVerifiedAt',
          'purchaseDate'
        ])
        && (!('trialEverStarted' in request.resource.data) || request.resource.data.trialEverStarted == false)
        && (!('trialStatus' in request.resource.data) || request.resource.data.trialStatus == 'not_started');
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isSubscribed',
          'subscriptionStatus',
          'subscriptionExpiryDate',
          'subscriptionExpiryTime',
          'expiryDate',
          'subscriptionProductId',
          'subscriptionBasePlan',
          'subscriptionBasePlanId',
          'planId',
          'autoRenewing',
          'purchaseToken',
          'orderId',
          'acknowledged',
          'lastVerifiedAt',
          'purchaseDate',
          'trialStartDate',
          'trialEndDate',
          'trialEverStarted',
          'trialStatus'
        ]);
      allow delete: if isOwner(userId);

      // Leads subcollection - strictly isolated to the authenticated active agent
      match /leads/{leadId} {
        allow read, write: if isAccountActive(userId);
      }

      // Properties subcollection - strictly isolated to the authenticated active agent
      match /properties/{propertyId} {
        allow read, write: if isAccountActive(userId);
      }

      // WhatsApp templates subcollection - strictly isolated to the authenticated active agent
      match /templates/{templateId} {
        allow read, write: if isAccountActive(userId);
      }
    }

    // Subscriptions collection: durable Google Play verification and entitlement data
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Durable Account Deletion Jobs: managed strictly by backend server
    match /accountDeletionJobs/{jobId} {
      allow read, write: if false;
    }

    // Fallback: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
