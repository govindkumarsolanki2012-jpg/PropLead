rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the caller owns the user resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Root user document
    match /users/{userId} {
      // Agents can read and write their own profile
      allow read, write: if isOwner(userId);

      // Leads subcollection - strictly isolated to the authenticated agent
      // Contains customer details, BHK, requirements, budget, follow-ups, and activity history
      match /leads/{leadId} {
        allow read, write: if isOwner(userId);
      }

      // Properties subcollection - strictly isolated to the authenticated agent
      // Contains inventory, owner contact, photos, and matching attributes
      match /properties/{propertyId} {
        allow read, write: if isOwner(userId);
      }

      // WhatsApp templates subcollection - strictly isolated to the authenticated agent
      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Subscriptions collection - isolated to the owning agent / authenticated user
    match /subscriptions/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Fallback: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
